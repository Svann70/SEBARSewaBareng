{
  "name": "sebar-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env db/seed.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
